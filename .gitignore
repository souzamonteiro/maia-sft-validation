# ============================================================
# Model outputs / checkpoints
# ============================================================

# Ignore training outputs by default
outputs/*

# Keep output directory
!outputs/.gitkeep

# Keep reproducible deployment files
!outputs/deploy/
outputs/deploy/*

!outputs/deploy/maia-lite-355m-stage4/
!outputs/deploy/maia-lite-355m-stage4/*.py
!outputs/deploy/maia-lite-355m-stage4/*.sh
!outputs/deploy/maia-lite-355m-stage4/Modelfile
!outputs/deploy/maia-lite-355m-stage4/README.md
!outputs/deploy/maia-lite-355m-stage4/SHA256SUMS

# Never commit model binaries
outputs/deploy/maia-lite-355m-stage4/merged-hf/
outputs/deploy/maia-lite-355m-stage4/gguf/

checkpoints/

*.safetensors
*.gguf
*.bin
*.pt
*.pth
*.ckpt


